# Razorpay Configuration (Test Keys)
RAZORPAY_KEY_ID=your_razorpay_test_key_id
RAZORPAY_KEY_SECRET=your_razorpay_test_key_secret

# JWT Configuration - Generate a strong random secret key
JWT_SECRET=your_secure_jwt_secret_here_at_least_64_characters_recommended

# Database Configuration
DB_PASSWORD=your_secure_database_password

# Port (optional, defaults to 8080 on Render)
PORT=8080

# Spring Profile (leave as prod for Render)
SPRING_PROFILES_ACTIVE=prod
